{
  "name": "factorfactor-development",
  "private": true,
  "scripts": {
    "build:tower": "node scripts/build-math-tower.cjs",
    "test:tower": "node --test tests/math-tower-*.test.cjs",
    "test:tower:browser": "node tests/math-tower-browser.cjs",
    "test:tower:rules": "node scripts/run-math-tower-rules.cjs",
    "test:tower:audit": "node scripts/run-math-tower-rules.cjs production-audit",
    "test:regression": "node tests/legacy-regression.cjs",
    "build:pages": "npm run build:tower && node scripts/build-pages.cjs",
    "test:online": "node tests/online-regression.cjs",
    "test:ci:rules": "node scripts/ci-emulator-checks.cjs",
    "test:accounts": "node tests/account-ranking-regression.cjs",
    "test:audio": "node --test tests/game-audio.test.cjs && node tests/audio-regression.cjs",
    "test:tower:recovery": "node tests/math-tower-recovery-browser.cjs"
  },
  "devDependencies": {
    "esbuild": "0.23.1",
    "playwright": "1.64.0",
    "firebase": "12.12.0",
    "@firebase/rules-unit-testing": "5.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@babel/standalone": "8.0.7",
    "tone": "14.8.49",
    "@tailwindcss/browser": "4.3.3"
  }
}
