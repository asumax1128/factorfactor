{
  "name": "factorfactor-development",
  "private": true,
  "scripts": {
    "build:tower": "node scripts/build-math-tower.cjs",
    "test:tower": "node --test tests/math-tower-*.test.cjs",
    "test:tower:browser": "node tests/math-tower-browser.cjs",
    "test:tower:rules": "node scripts/run-math-tower-rules.cjs",
    "test:tower:audit": "node scripts/run-math-tower-rules.cjs production-audit",
    "test:regression": "node tests/legacy-regression.cjs",
    "build:pages": "node scripts/build-version.cjs && npm run build:tower && npm run build:online-rated && node scripts/build-pages.cjs",
    "test:online": "node tests/online-regression.cjs",
    "test:ci:rules": "node scripts/ci-emulator-checks.cjs",
    "test:accounts": "node tests/account-ranking-regression.cjs",
    "test:audio": "node --test tests/game-audio.test.cjs && node tests/audio-regression.cjs",
    "test:tower:recovery": "node tests/math-tower-recovery-browser.cjs",
    "test:tower:rpg": "node tests/math-tower-rpg-browser.cjs",
    "test:tower:polish": "node tests/math-tower-ui-polish.cjs",
    "test:tower:flow": "node tests/math-tower-flow-browser.cjs",
    "build:online-rated": "node scripts/build-online-rated.cjs",
    "test:online-rated": "node --test tests/online-rated.test.cjs tests/online-rated-migration.test.cjs && node tests/online-spark-browser.cjs",
    "test:tower:background": "node tests/math-tower-floor3-background.cjs",
    "test:online-entry": "node tests/online-spark-entry.cjs",
    "test:online-menu": "node tests/online-menu-browser.cjs",
    "test:version": "node --test tests/game-version.test.cjs",
    "test:ghost": "node --test tests/ghost-learning.test.cjs && node tests/ghost-ui-browser.cjs",
    "test:online-playability": "node tests/online-playability-browser.cjs",
    "test:online-presentation": "node --test tests/combat-events-v514.test.cjs && node tests/online-ui-v514.cjs",
    "test:ui-font": "node tests/ui-font-v515.cjs",
    "test:online-latency": "node --test tests/online-state-order.test.cjs && node tests/online-latency-browser.cjs",
    "test:bounty-profile": "node tests/bounty-profile-browser.cjs",
    "test:chromebook": "node tests/chromebook-browser.cjs",
    "test:rating-history": "node --test tests/rating-history.test.cjs && node tests/rating-history-browser.cjs",
    "test:rating-display": "node --test tests/rating-display.test.cjs && node tests/rating-display-browser.cjs",
    "test:online-improvements": "node --test tests/online-improvements.test.cjs && node tests/battle-countdown-browser.cjs && node tests/master-effect-browser.cjs && node tests/online-improvements-browser.cjs",
    "test:online-v524": "node --test tests/b2.test.cjs tests/daily-model.test.cjs tests/daily-play.test.cjs tests/hyper-top10.test.cjs && node tests/v524-browser.cjs",
    "test:rewards-audit": "node tests/rewards-audit.cjs && node tests/rewards-audit-browser.cjs"
  },
  "devDependencies": {
    "esbuild": "0.23.1",
    "playwright": "1.64.0",
    "firebase": "12.12.0",
    "@firebase/rules-unit-testing": "5.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@babel/standalone": "8.0.7",
    "tone": "14.8.49",
    "@tailwindcss/browser": "4.3.3"
  }
}
