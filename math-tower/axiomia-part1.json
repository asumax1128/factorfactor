{"part":1,"version":1,"title":"AXIOMIA 第1部","note":"Generated by scripts/build-axiomia.cjs from docs/axiomia/story. Public game material; teacher access is enforced in the game, not by hiding this file.","policy":{"id":"ch1-approved-trial-20261012","miss":5,"timeout":10,"problemMs":45000,"bossUnits":15,"bossAbility":"double-miss","bossHeal":100,"weights":[0.5,0.3,0.2],"ranks":[0.95,0.85,0.7],"hardHighGuard":true},"characters":{"count_rabbit":{"trueName":"カウント・ラビット","placeholder":"🐰","facePosition":"58% 40%","faceScale":1.9,"color":"#E9C46A","image":"img/axiomia/chars/count_rabbit.webp","floor":1},"zero_slime":{"trueName":"ゼロ・スライム","displayNameBeforeReveal":"？？？","displayNameAfterReveal":"ゼロ・スライム","revealKey":"zero_slime","placeholder":"💧","facePosition":"53% 55%","faceScale":1.8,"color":"#7DD3FC","image":"img/axiomia/chars/zero_slime.webp","floor":2},"plus":{"trueName":"プラス","placeholder":"🦊","facePosition":"67% 37%","faceScale":2,"color":"#F97316","image":"img/axiomia/chars/plus.webp","floor":3},"minus":{"trueName":"マイナス","placeholder":"🦊","placeholderFilter":"hue-rotate(220deg) saturate(.8)","facePosition":"71% 40%","faceScale":2,"color":"#7C6CF0","image":"img/axiomia/chars/minus.webp","floor":3},"twin_fox":{"trueName":"プラスとマイナス","placeholder":"🦊","facePosition":"50% 35%","faceScale":1.5,"unit":["plus","minus"],"color":"#C084FC","image":"img/axiomia/chars/twin_fox.webp","floor":3},"abs_wolf":{"trueName":"アブソリュート・ウルフ","placeholder":"🐺","facePosition":"80% 24%","faceScale":2.2,"color":"#94A3B8","image":"img/axiomia/chars/abs_wolf.webp","floor":4},"nul":{"trueName":"零の番人ヌル","short":"ヌル","placeholder":"🦁","facePosition":"83% 29%","faceScale":2.1,"color":"#A78BFA","image":"img/axiomia/chars/nul.webp","floor":5},"voice":{"trueName":"謎の声","placeholder":"📖","noPortrait":true,"color":"#F3D27A"}},"backgrounds":{"classroom":{"name":"BG-P01 夕暮れの教室","image":"img/axiomia/bg/classroom.webp","focus":"62% 50%"},"classroom-light":{"name":"夕暮れの教室（光が差し込む）","image":"img/axiomia/bg/classroom.webp","focus":"62% 50%","overlay":"radial-gradient(ellipse at 50% 62%,#fff1b866,#09133366 72%)"},"classroom-geo":{"name":"夕暮れの教室（幾何学の光）","image":"img/axiomia/bg/classroom.webp","focus":"62% 50%","overlay":"repeating-conic-gradient(from 0deg at 50% 58%,#7cc8ff2e 0 9deg,#0000 9deg 18deg),linear-gradient(#09133377,#091333aa)"},"starfield":{"name":"星空のような空間（仮）","placeholder":true,"css":"radial-gradient(circle at 18% 28%,#fff 0 1px,#0000 2px),radial-gradient(circle at 72% 58%,#cfe8ff 0 1px,#0000 2px),radial-gradient(circle at 44% 82%,#fff 0 1px,#0000 2px),radial-gradient(circle at 86% 16%,#fff 0 1px,#0000 2px),linear-gradient(180deg,#040820,#10245e)","size":"170px 170px,230px 230px,150px 150px,210px 210px,cover"},"starfield-dim":{"name":"星空のような空間・暗転（仮）","placeholder":true,"css":"radial-gradient(circle at 50% 50%,#2b2f55 0,#05060f 70%)"},"l1-gate":{"name":"第1層 街の入口（仮）","placeholder":true,"css":"linear-gradient(180deg,#27406b,#8fa8c8 55%,#e5ecf5)"},"l1-market":{"name":"第1層 計数市場（仮）","placeholder":true,"css":"linear-gradient(180deg,#5a4a2a,#c79a45 60%,#f1d79a)"},"l1-pool":{"name":"第1層 空の水晶池（仮）","placeholder":true,"css":"linear-gradient(180deg,#0d3550,#2c8fb5 60%,#bfe9f6)"},"l1-crossroad":{"name":"第1層 正負の分岐路（仮）","placeholder":true,"css":"linear-gradient(90deg,#8a3b1f,#3a3f66 50%,#25408a)"},"l1-hill":{"name":"第1層 絶対値の丘（仮）","placeholder":true,"css":"linear-gradient(180deg,#2c4a5e,#4f8a63 62%,#a7cf8d)"},"l1-garden":{"name":"第1層 始原の封印庭園（仮）","placeholder":true,"css":"linear-gradient(180deg,#1b1233,#4b3a7a 58%,#9d8ad1)"},"l1-plaza":{"name":"第1層 ゼロの広場（仮）","placeholder":true,"css":"linear-gradient(180deg,#223a58,#6ea7c9 60%,#e9f6ff)"},"l1-north-gate":{"name":"第1層 街の北端・界門（仮）","placeholder":true,"css":"linear-gradient(180deg,#14284a,#5d7fb3 60%,#f2e6bd)"}},"monsters":{"count_rabbit":{"motif":"位取り記数法","nature":"小柄なクリーム色のウサギ。耳に数字の模様があり、そろばん型のペンダントを下げている。明るく好奇心旺盛で、数えることが大好き。"},"zero_slime":{"motif":"0（ゼロ）","nature":"淡い水色の半透明なスライム。お腹の丸い紋章が消えかけている。ていねいな言葉で話す。"},"twin_fox":{"motif":"正の数と負の数","nature":"赤橙色のプラス（オレ）と、青紫色のマイナス（わたし）の兄妹狐。いつも言い争っているが、仲はいい。"},"abs_wolf":{"motif":"絶対値・原点からの距離","nature":"銀灰色の毛並みと深い青の瞳をもつ大きな狼。体には左右対称の幾何学模様。寡黙で誠実な、零の番人の守護者。"},"nul":{"motif":"0・数の起点","nature":"黒曜石のような装甲をもつ巨大な獅子の守護獣。胸には円環の紋章がある。かつて数の世界の均衡を守っていた。"}},"prologue":{"events":[{"id":"AX1-L00-S1","title":"プロローグ Scene 1 ｜ 放課後の教室","notebook":true,"bg":"classroom","src":{"file":"00_prologue.md","from":20,"to":60},"lines":[["narr","放課後の教室",{"kind":"card","card":[{"s":"xs","t":"Scene 1"},{"s":"lg","t":"放課後の教室"}],"fx":"fadein"},"00_prologue.md:20"],["narr","窓から夕日が差し込む。部活動の声が遠くに聞こえる。教室には主人公だけが残っている。",null,"00_prologue.md:24"],["hero","……よし、終わった。",null,"00_prologue.md:26"],["narr","ノートには、解き終えた因数分解の問題が並んでいる。",null,"00_prologue.md:28"],["hero","展開して、また因数分解して……。同じ式なのに、形が変わるんだよな。",null,"00_prologue.md:30"],["narr","主人公がノートを閉じようとした、そのとき。",null,"00_prologue.md:32"],["hero","……あれ？",null,"00_prologue.md:34"],["narr","ページの端に、見覚えのない文字が浮かんでいる。",null,"00_prologue.md:36"],["narr","数は、世界をつなぐ。",{"kind":"note","fx":"noteglow"},"00_prologue.md:38"],["hero","こんなの、書いたっけ……？",null,"00_prologue.md:42"],["narr","文字を指でなぞる。",null,"00_prologue.md:44"],["narr","一瞬、胸の奥が締めつけられるような、不思議な感覚がした。",null,"00_prologue.md:46"],["hero","……なんだろう。初めて見るはずなのに。",null,"00_prologue.md:48"],["narr","さらり。",null,"00_prologue.md:50"],["narr","誰もいない教室の後ろから、紙をめくる音が聞こえる。",null,"00_prologue.md:52"],["hero","……誰かいる？",null,"00_prologue.md:54"],["narr","返事はない。",null,"00_prologue.md:56"],["narr","さらり、さらり。",null,"00_prologue.md:58"],["narr","主人公はゆっくりと振り返る。",null,"00_prologue.md:60"]]},{"id":"AX1-L00-S2","title":"プロローグ Scene 2 ｜ コーデックス・アクシオマ","bookScene":true,"bg":"classroom-light","src":{"file":"00_prologue.md","from":64,"to":129},"lines":[["narr","コーデックス・アクシオマ",{"kind":"card","card":[{"s":"xs","t":"Scene 2"},{"s":"lg","t":"コーデックス・アクシオマ"}]},"00_prologue.md:64"],["narr","教室の一番後ろ。",null,"00_prologue.md:68"],["narr","さっきまで何もなかった机の上に、一冊の古い書物が置かれている。",{"fx":"book"},"00_prologue.md:70"],["hero","……本？",null,"00_prologue.md:72"],["narr","表紙には、途中で欠けた円環の紋章。中央には、淡く輝く宝石が埋め込まれている。",null,"00_prologue.md:74"],["hero","誰かの忘れ物……にしては、変わった本だな。",null,"00_prologue.md:76"],["narr","主人公が手を伸ばす。",null,"00_prologue.md:78"],["narr","触れる直前、書物がひとりでに開いた。",{"fx":"bookopen"},"00_prologue.md:80"],["hero","うわっ!?",null,"00_prologue.md:82"],["narr","ページから幾何学模様の光が浮かび上がる。",{"fx":"particles"},"00_prologue.md:84"],["narr","複雑な文字が次々と並び替わり、一つの名前が現れる。",null,"00_prologue.md:86"],["narr","CODEX AXIOMA",{"kind":"card","card":[{"s":"xl","t":"CODEX AXIOMA"},{"s":"md","t":"コーデックス・アクシオマ"}],"fx":"fadein"},"00_prologue.md:88"],["hero","コーデックス……アクシオマ？",null,"00_prologue.md:93"],["narr","その名前を口にした瞬間、光が静かに脈打つ。",null,"00_prologue.md:95"],["voice","……ようやく、見つけました。",{"name":"謎の声"},"00_prologue.md:97"],["hero","!?",null,"00_prologue.md:99"],["narr","主人公は振り返る。",null,"00_prologue.md:101"],["hero","誰!?　どこにいるの？",null,"00_prologue.md:103"],["voice","驚かせてしまいましたね。",{"name":"謎の声"},"00_prologue.md:105"],["hero","そりゃ驚くよ！　誰もいないのに声がするんだから！",null,"00_prologue.md:107"],["voice","……ふふ。",{"name":"謎の声"},"00_prologue.md:109"],["narr","小さな笑い声。",null,"00_prologue.md:111"],["hero","……笑った？",null,"00_prologue.md:113"],["voice","ごめんなさい。少しだけ、安心してしまって。",{"name":"謎の声"},"00_prologue.md:115"],["hero","安心？",null,"00_prologue.md:117"],["voice","はい。あなたと、こうして話せたことに。",{"name":"謎の声"},"00_prologue.md:119"],["hero","……僕のこと、知ってるの？",null,"00_prologue.md:121"],["narr","わずかな沈黙。",null,"00_prologue.md:123"],["voice","……あなたのことを、知りたいと思っていました。",{"name":"謎の声"},"00_prologue.md:125"],["hero","それ、答えになってない気がするけど……。",null,"00_prologue.md:127"],["narr","書物のページが、ひとりでに一枚めくられる。",null,"00_prologue.md:129"]]},{"id":"AX1-L00-S3","title":"プロローグ Scene 3 ｜ 最初の会話","bookScene":true,"bg":"classroom-geo","src":{"file":"00_prologue.md","from":133,"to":221},"lines":[["narr","最初の会話",{"kind":"card","card":[{"s":"xs","t":"Scene 3"},{"s":"lg","t":"最初の会話"}]},"00_prologue.md:133"],["hero","ねえ。君は、この本なの？",{"fx":"book"},"00_prologue.md:137"],["voice","……今は、そのように考えてください。",{"name":"謎の声"},"00_prologue.md:139"],["hero","今は？",null,"00_prologue.md:141"],["voice","お伝えできることが、まだ少ないのです。",{"name":"謎の声"},"00_prologue.md:143"],["hero","怪しいなあ……。",null,"00_prologue.md:145"],["voice","……そうですね。",{"name":"謎の声"},"00_prologue.md:147"],["hero","否定しないんだ。",null,"00_prologue.md:149"],["voice","ですが、あなたを傷つけたいわけではありません。それだけは、信じてほしいのです。",{"name":"謎の声"},"00_prologue.md:151"],["narr","書物のページに、小さな街の光景が映し出される。",{"fx":"bookopen"},"00_prologue.md:153"],["narr","看板の数字が欠け、住人たちが困惑している。",null,"00_prologue.md:155"],["hero","……これ、何？",null,"00_prologue.md:157"],["voice","AXIOMIA。アクシオミアという世界です。",{"name":"謎の声"},"00_prologue.md:159"],["hero","アクシオミア……。",null,"00_prologue.md:161"],["voice","この世界では、数や式が持つ役割が、さまざまなものを支えています。",{"name":"謎の声"},"00_prologue.md:163"],["hero","数や式が？",null,"00_prologue.md:165"],["voice","はい。ですが今、その役割とつながりが失われ始めています。",{"name":"謎の声"},"00_prologue.md:167"],["narr","ページに映る街の光が、少しずつ弱まる。",null,"00_prologue.md:169"],["hero","……街の人たち、困ってるみたいだね。",null,"00_prologue.md:171"],["voice","失われたつながりを取り戻すためには、このコーデックス・アクシオマが必要です。",{"name":"謎の声"},"00_prologue.md:173"],["hero","でも、どうして僕に？",null,"00_prologue.md:175"],["voice","……。",{"name":"謎の声"},"00_prologue.md:177"],["hero","僕は、普通の高校生だよ。そんな世界を救う力なんてない。",null,"00_prologue.md:179"],["voice","今すぐ、世界を救ってほしいとは言いません。",{"name":"謎の声"},"00_prologue.md:181"],["hero","え？",null,"00_prologue.md:183"],["voice","まずは、目の前で困っている人たちを助けてほしいのです。",{"name":"謎の声"},"00_prologue.md:185"],["hero","……。",null,"00_prologue.md:187"],["voice","あなたなら、きっと……。",{"name":"謎の声"},"00_prologue.md:189"],["narr","声が途切れる。",null,"00_prologue.md:191"],["voice","……今度こそ……。",{"name":"謎の声"},"00_prologue.md:193"],["hero","今度こそ？",null,"00_prologue.md:195"],["voice","……いえ。何でもありません。",{"name":"謎の声"},"00_prologue.md:197"],["hero","さっきから、何か隠してない？",null,"00_prologue.md:199"],["voice","……隠していることは、あります。",{"name":"謎の声"},"00_prologue.md:201"],["hero","そこも正直なんだ。",null,"00_prologue.md:203"],["voice","ですが、いつか必ず、お話しします。",{"name":"謎の声"},"00_prologue.md:205"],["hero","……分かった。",null,"00_prologue.md:207"],["narr","主人公は書物に映る街を見つめる。",null,"00_prologue.md:209"],["hero","僕にできることがあるかは分からないけど……。",null,"00_prologue.md:211"],["voice","はい。",{"name":"謎の声"},"00_prologue.md:213"],["hero","あの人たちが困ってるなら、放っておけない。",null,"00_prologue.md:215"],["narr","書物が、ひときわ明るく輝く。",{"fx":"particles"},"00_prologue.md:217"],["voice","……ありがとうございます。",{"name":"謎の声"},"00_prologue.md:219"],["narr","その声は、ほんの少し震えていた。",null,"00_prologue.md:221"]]},{"id":"AX1-L00-S4","title":"プロローグ Scene 4 ｜ 十の世界の幻視","bg":"starfield","src":{"file":"00_prologue.md","from":225,"to":341},"lines":[["narr","十の世界の幻視",{"kind":"card","card":[{"s":"xs","t":"Scene 4"},{"s":"lg","t":"十の世界の幻視"}]},"00_prologue.md:225"],["narr","教室の床に、幾何学模様の光が広がる。",{"bg":"classroom-geo"},"00_prologue.md:229"],["hero","えっ、ちょっと待って！　何が起きてるの!?",null,"00_prologue.md:231"],["voice","世界への道が、開こうとしています。",{"name":"謎の声"},"00_prologue.md:233"],["hero","世界への道って……うわっ！",null,"00_prologue.md:235"],["narr","窓の外の景色が、光の粒になって消える。",{"fx":"particles"},"00_prologue.md:237"],["narr","机も、黒板も、教室の壁も、静かにほどけていく。",null,"00_prologue.md:239"],["narr","気がつくと、主人公は星空のような空間に立っていた。",{"bg":"starfield","fx":"white"},"00_prologue.md:241"],["hero","……ここ、どこ？",null,"00_prologue.md:243"],["voice","世界と世界の狭間です。",{"name":"謎の声"},"00_prologue.md:245"],["narr","暗闇の中に、一つの世界が浮かび上がる。",null,"00_prologue.md:247"],["narr","赤い水晶の森。無数の煙突が立ち並ぶ工房の街。巨大な炎の門。",null,"00_prologue.md:249"],["hero","……すごい。",null,"00_prologue.md:251"],["narr","次の瞬間、景色が変わる。",null,"00_prologue.md:253"],["narr","白銀の都市。その空には、巨大な天秤が浮かんでいる。",null,"00_prologue.md:255"],["hero","街が……空に？",null,"00_prologue.md:257"],["voice","アクシオミアには、それぞれ異なる姿を持つ世界が存在します。",{"name":"謎の声"},"00_prologue.md:259"],["narr","さらに景色が移り変わる。",null,"00_prologue.md:261"],["narr","青い海の底で、幾何学模様の光が揺れる。",null,"00_prologue.md:263"],["narr","無数の鏡が、空と大地を映し合う。",null,"00_prologue.md:265"],["narr","見知らぬ世界が、次々と姿を現す。",null,"00_prologue.md:267"],["hero","……こんなに、たくさんの世界が。",null,"00_prologue.md:269"],["voice","はい。そして、それらは本来、互いにつながっていました。",{"name":"謎の声"},"00_prologue.md:271"],["hero","本来……？",null,"00_prologue.md:273"],["voice","今は、その道の多くが閉ざされています。",{"name":"謎の声"},"00_prologue.md:275"],["hero","じゃあ、世界ごとに行き来できなくなってるんだ。",null,"00_prologue.md:277"],["voice","そうです。ですが、世界をつなぐ『界門』は、まだ失われていません。",{"name":"謎の声"},"00_prologue.md:279"],["hero","界門……。",null,"00_prologue.md:281"],["voice","それぞれの世界に残る異変を解き、守護者の試練を越えることで、次の世界への道が開かれます。",{"name":"謎の声"},"00_prologue.md:283"],["hero","……なるほど。",null,"00_prologue.md:285"],["narr","主人公は、幾重にも重なる世界の光を見上げる。",null,"00_prologue.md:287"],["hero","なんだか、すごく遠くまで来ちゃった気がする。",null,"00_prologue.md:289"],["voice","……まだ、旅は始まっていませんよ。",{"name":"謎の声"},"00_prologue.md:291"],["hero","えっ!?　これで始まってないの!?",null,"00_prologue.md:293"],["narr","声が、少しだけ笑う。",null,"00_prologue.md:295"],["voice","はい。ここからが、本当の始まりです。",{"name":"謎の声"},"00_prologue.md:297"],["narr","突然、世界の光が暗くなる。",{"bg":"starfield-dim","fx":"black"},"00_prologue.md:301"],["narr","闇の中に、欠けた円環が浮かび上がる。",null,"00_prologue.md:303"],["narr","その向こうに、誰かの影が見える。",null,"00_prologue.md:305"],["hero","……誰？",null,"00_prologue.md:307"],["narr","影は何も答えない。",null,"00_prologue.md:309"],["narr","ただ、主人公の方を向いている。",null,"00_prologue.md:311"],["narr","その瞬間、胸の奥に、説明できない懐かしさが走る。",null,"00_prologue.md:313"],["hero","……僕、この人を……？",null,"00_prologue.md:315"],["narr","影が消える。",null,"00_prologue.md:317"],["hero","……っ！",null,"00_prologue.md:319"],["voice","どうしました？",{"name":"謎の声"},"00_prologue.md:321"],["hero","今、誰かが見えたんだ。",null,"00_prologue.md:323"],["voice","……。",{"name":"謎の声"},"00_prologue.md:325"],["hero","知ってる人だったような……でも、思い出せない。",null,"00_prologue.md:327"],["voice","……そう、ですか。",{"name":"謎の声"},"00_prologue.md:329"],["hero","君も見えた？",null,"00_prologue.md:331"],["voice","……私には、分かりません。",{"name":"謎の声"},"00_prologue.md:333"],["narr","書物のページが静かに閉じる。",null,"00_prologue.md:335"],["voice","今は、先へ進みましょう。",{"name":"謎の声"},"00_prologue.md:337"],["hero","……うん。",null,"00_prologue.md:339"],["narr","足元に、白銀の光が広がる。",{"fx":"white"},"00_prologue.md:341"]]},{"id":"AX1-L00-S5","title":"プロローグ Scene 5 ｜ 第1層「ゼロの消えた街」","bg":"l1-gate","src":{"file":"00_prologue.md","from":345,"to":422},"lines":[["narr","第1層「ゼロの消えた街」",{"kind":"card","card":[{"s":"xs","t":"Scene 5"},{"s":"lg","t":"第1層「ゼロの消えた街」"}]},"00_prologue.md:345"],["narr","光が消える。",{"fx":"white"},"00_prologue.md:349"],["narr","主人公は、白銀の石畳の道に立っていた。",null,"00_prologue.md:351"],["narr","目の前には、繊細な金装飾が施された建物が並んでいる。",null,"00_prologue.md:353"],["narr","空には透明な水晶が浮かび、淡い光を放っていた。",null,"00_prologue.md:355"],["hero","……着いた？",null,"00_prologue.md:357"],["voice","はい。ここがアクシオミアの第一の世界です。",{"name":"謎の声"},"00_prologue.md:359"],["hero","本当に、異世界に来ちゃったんだ……。",null,"00_prologue.md:361"],["narr","主人公は辺りを見回す。",null,"00_prologue.md:363"],["narr","街は美しい。しかし、どこか様子がおかしい。",null,"00_prologue.md:365"],["narr","店の看板に書かれた数字が欠けている。",null,"00_prologue.md:367"],["narr","時計の表示も、ところどころ不自然だ。",null,"00_prologue.md:369"],["hero","……あれ？",null,"00_prologue.md:371"],["voice","どうしました？",{"name":"謎の声"},"00_prologue.md:373"],["hero","数字が、おかしくない？",null,"00_prologue.md:375"],["narr","主人公が看板を指さす。",null,"00_prologue.md:377"],["hero","あそこ、数字が一つ抜けてる。",null,"00_prologue.md:379"],["voice","……気づきましたか。",{"name":"謎の声"},"00_prologue.md:381"],["hero","これが、世界の異変？",null,"00_prologue.md:383"],["voice","はい。この街では、ある大切な数の役割が失われています。",{"name":"謎の声"},"00_prologue.md:385"],["hero","ある大切な数……？",null,"00_prologue.md:387"],["narr","そのとき、遠くから小さな足音が聞こえてくる。",null,"00_prologue.md:389"],["count_rabbit","大変だ！　大変だーっ！",{"name":"？？？"},"00_prologue.md:391"],["narr","一匹のウサギのような小さなモンスターが、慌てた様子で走ってくる。",null,"00_prologue.md:393"],["hero","えっ、ウサギ!?",null,"00_prologue.md:395"],["count_rabbit","おい、そこの人間！　ちょっと助けてくれ！",{"name":"カウント・ラビット"},"00_prologue.md:397"],["hero","ぼ、僕？",null,"00_prologue.md:399"],["count_rabbit","そうだよ！　この街、もうめちゃくちゃなんだ！",{"name":"カウント・ラビット"},"00_prologue.md:401"],["hero","何があったの？",null,"00_prologue.md:403"],["count_rabbit","数が……数が、おかしくなっちゃったんだよ！",{"name":"カウント・ラビット"},"00_prologue.md:405"],["narr","主人公はコーデックス・アクシオマを見る。",null,"00_prologue.md:407"],["hero","……最初の事件、ってことかな。",null,"00_prologue.md:409"],["voice","はい。ここから、あなたの旅が始まります。",{"name":"謎の声"},"00_prologue.md:411"],["hero","……よし。まずは話を聞いてみよう。",null,"00_prologue.md:413"],["narr","カウント・ラビットが主人公を街の中心へ案内する。",null,"00_prologue.md:415"],["narr","画面がゆっくりと暗転する。",{"fx":"black"},"00_prologue.md:417"],["narr","第1層「ゼロの消えた街」",{"kind":"card","card":[{"s":"xs","t":"PROLOGUE COMPLETE"},{"s":"lg","t":"第1層「ゼロの消えた街」"},{"s":"sm","t":"冒険の始まり"}],"fx":"fadein"},"00_prologue.md:419"]]}]},"layers":[{"layer":1,"title":"ゼロの消えた街","floors":{"1":"count_rabbit","2":"zero_slime","3":"twin_fox","4":"abs_wolf","5":"nul"},"battleBg":{"1":"l1-market","2":"l1-pool","3":"l1-crossroad","4":"l1-hill","5":"l1-garden"},"notes":[{"floor":1,"title":"数を表す仕組み","law":"ふだん使っている数の書き方は「十進位取り記数法」。右から一の位・十の位・百の位…と並び、左へ1つ進むごとに位の大きさが10倍になる。","formulas":["100 = 1×100 + 0×10 + 0×1","101 = 1×100 + 0×10 + 1×1"],"point":"0 は「その位には何もない」ことを示す。0 がなければ 101 と 11 を区別できない。0 は位を正しく表すために欠かせない。"},{"floor":2,"title":"ゼロの役割","law":"0 は「何もない」ことを表す数。ある数から同じ数を引くと 0 になる。0 を足しても、もとの数は変わらない。","formulas":["3 − 3 = 0","a + 0 = a（0 を足しても変わらない）","a × 0 = 0","0 で割ることはできない（例：5 ÷ 0 は答えが決められない）"],"point":"10 の 0 は「一の位が 0 個」を伝えている。何もないことを表すのも、数の大切な役割。"},{"floor":3,"title":"正の数と負の数","law":"数直線では、0 を基準にして右側に正の数、左側に負の数が並ぶ。","formulas":["0 より大きい数は正の数（+1, +2, +3, …）","0 より小さい数は負の数（−1, −2, −3, …）","0 は正の数でも負の数でもない","3℃ から −2℃ への変化は (−2) − 3 = −5（5℃ 下がった）"],"point":"正と負をまたぐ変化は、0 を通って考えるとわかりやすい（3 → 0 で 3 下がり、0 → −2 でさらに 2 下がる）。"},{"floor":4,"title":"絶対値と原点","law":"数直線上で、原点（0）からその数までの距離を「絶対値」という。距離なので、絶対値は負にならない。","formulas":["|5| = |−5| = 5","|0| = 0","2点 a, b の間の距離は |a − b|（例：3 と −2 の距離は |3 − (−2)| = 5）"],"point":"符号がちがっても、原点からの距離が同じなら絶対値は等しい。原点（基準）がなければ距離は決められない。"}],"fragment":{"no":1,"floor":5,"boss":"nul","name":"数の起点","title":"第一の断片","law":"0 は「何もない」ことを表す数。位取り記数法では空いている位を示し、数直線では正の数と負の数を分ける基準（原点）になる。0 は正の数でも負の数でもない。","formulas":["100 = 1×100 + 0×10 + 0×1（0 が空いた位を示す）","a + 0 = a、a − a = 0","a × 0 = 0、0 で割ることはできない","|a| は原点 0 からの距離（いつも 0 以上）"],"links":"0 があるから 1 と 10 を区別できる。気温の 0℃ や海面の高さ 0 m のように、ものごとの「基準」を決めるときにも 0 が使われる。","quote":"何もないことを知る者は、すべての始まりを知る。","story":""},"flow":{"pre":{"1":["AX1-L01-P1-pre"],"2":["AX1-L01-P2-pre"],"3":["AX1-L01-P3-pre"],"4":["AX1-L01-P4-pre"],"5":["AX1-L01-P5-pre"]},"post":{"1":["AX1-L01-P1-post"],"2":["AX1-L01-P2-post"],"3":["AX1-L01-P3-post"],"4":["AX1-L01-P4-post"],"5":["AX1-L01-P5-post","AX1-L01-clear","AX1-L01-fragment","AX1-L01-gate"]}},"events":[{"id":"AX1-L01-P1-pre","title":"ゼロの消えた街 1地点 計数市場","src":{"file":"01_layer_01.md","from":10,"to":42},"lines":[["narr","計数市場",{"kind":"card","card":[{"s":"xs","t":"第一幕"},{"s":"lg","t":"計数市場"}]},"01_layer_01.md:10"],["narr","白銀の石畳が続く市場。果物、鉱石、色とりどりの水晶が並ぶ店先では、住人たちが困り果てていた。",null,"01_layer_01.md:14"],["count_rabbit","大変なんだ！　品物の数が、どうしても合わないんだよ！",{"name":"カウント・ラビット"},"01_layer_01.md:16"],["hero","落ち着いて。何があったの？",null,"01_layer_01.md:18"],["count_rabbit","朝は百五個あった水晶が、記録では十五個になってるんだ！",{"name":"カウント・ラビット"},"01_layer_01.md:20"],["hero","百五個が十五個に？",null,"01_layer_01.md:22"],["count_rabbit","しかも、全部売り切れた箱は、記録することすらできない！",{"name":"カウント・ラビット"},"01_layer_01.md:24"],["narr","ラビットが帳簿を開く。そこには、数字の途中に不自然な空白があった。",null,"01_layer_01.md:26"],["hero","……もしかして、ゼロが抜けてる？",null,"01_layer_01.md:28"],["count_rabbit","ゼロ？　それって何？",{"name":"カウント・ラビット"},"01_layer_01.md:30"],["hero","何もないことを表す数だよ。それに、数字の位置を表すためにも必要なんだ。",null,"01_layer_01.md:32"],["count_rabbit","何もないのに、数が必要なの？",{"name":"カウント・ラビット"},"01_layer_01.md:34"],["hero","うん。例えば105と15は違う数でしょ？　その違いを表すのにもゼロが役立ってる。",null,"01_layer_01.md:36"],["count_rabbit","……うーん。頭がこんがらがってきた！",{"name":"カウント・ラビット"},"01_layer_01.md:38"],["hero","じゃあ、一緒に確かめよう。",null,"01_layer_01.md:40"],["count_rabbit","よーし！　この市場の数の試練、受けてみてよ！",{"name":"カウント・ラビット"},"01_layer_01.md:42"]],"bg":"l1-market"},{"id":"AX1-L01-P1-post","title":"1地点 戦闘後","src":{"file":"01_layer_01.md","from":44,"to":66},"lines":[["count_rabbit","すごいや！　君、数の扱いが上手なんだね！",{"name":"カウント・ラビット"},"01_layer_01.md:46"],["hero","ゼロがないと、数を正しく表すのが難しくなるんだ。",null,"01_layer_01.md:48"],["count_rabbit","じゃあ、この街の混乱も、そのゼロってやつが原因なのかな？",{"name":"カウント・ラビット"},"01_layer_01.md:50"],["voice","その可能性があります。街の中心から、数のつながりが弱まっているようです。",{"name":"コーデックスの声"},"01_layer_01.md:52"],["hero","街の中心……？",null,"01_layer_01.md:54"],["count_rabbit","ゼロの広場だよ！　でも、今は近づけないんだ。",{"name":"カウント・ラビット"},"01_layer_01.md:56"],["hero","どうして？",null,"01_layer_01.md:58"],["count_rabbit","広場へ続く水路がおかしくなって、道が通れなくなってる。",{"name":"カウント・ラビット"},"01_layer_01.md:60"],["hero","じゃあ、まずは水路を調べよう。",null,"01_layer_01.md:62"],["count_rabbit","ありがとう！　僕も市場のみんなに、今分かったことを伝えてみるよ！",{"name":"カウント・ラビット"},"01_layer_01.md:64"],["narr","市場の帳簿に、消えていた数字の一部が淡く浮かび上がる。",{"fx":"particles"},"01_layer_01.md:66"]],"bg":"l1-market"},{"id":"AX1-L01-P2-pre","title":"ゼロの消えた街 2地点 空の水晶池","src":{"file":"01_layer_01.md","from":70,"to":130},"lines":[["narr","空の水晶池",{"kind":"card","card":[{"s":"xs","t":"第二幕"},{"s":"lg","t":"空の水晶池"}]},"01_layer_01.md:70"],["narr","透明な水晶に囲まれた池。かつては水量を示す光が輝いていたが、今は水位を示す目盛りが途中で途切れている。",null,"01_layer_01.md:74"],["narr","池のほとりに、小さな青いスライムがうずくまっていた。",null,"01_layer_01.md:76"],["hero","あそこに、誰かいる。",null,"01_layer_01.md:78"],["zero_slime","……ぷる。",{"name":"スライム"},"01_layer_01.md:80"],["hero","どうしたの？",null,"01_layer_01.md:82"],["zero_slime","……わからない。",{"name":"スライム"},"01_layer_01.md:84"],["hero","何が？",null,"01_layer_01.md:86"],["zero_slime","ぼく、ここで何をしてたんだっけ……。",{"name":"スライム"},"01_layer_01.md:88"],["hero","覚えてないの？",null,"01_layer_01.md:90"],["zero_slime","みんなは、水がいっぱいあるときは喜ぶ。でも、なくなると困る。",{"name":"スライム"},"01_layer_01.md:92"],["hero","うん。",null,"01_layer_01.md:94"],["zero_slime","ぼくは、何もないときのことを知らせていた気がするんだ。",{"name":"スライム"},"01_layer_01.md:96"],["hero","……空になったことを？",null,"01_layer_01.md:98"],["zero_slime","でも、何もないなら、ぼくもいらないのかな……。",{"name":"スライム"},"01_layer_01.md:100"],["narr","主人公は空になった水晶の器を見つめる。",null,"01_layer_01.md:102"],["hero","そんなことないよ。",null,"01_layer_01.md:104"],["zero_slime","……？",{"name":"スライム"},"01_layer_01.md:106"],["hero","水がないって分からなかったら、補充しようとも思えないでしょ？",null,"01_layer_01.md:108"],["zero_slime","……あ。",{"name":"スライム"},"01_layer_01.md:110"],["hero","何もないことを知るのも、大切なんだ。",null,"01_layer_01.md:112"],["zero_slime","ぼくにも……役割がある？",{"name":"スライム"},"01_layer_01.md:114"],["hero","もちろん。",null,"01_layer_01.md:116"],["narr","スライムの体が、ほんの少し明るくなる。",null,"01_layer_01.md:118"],["zero_slime","……だったら、確かめたい。",{"name":"スライム"},"01_layer_01.md:120"],["hero","何を？",null,"01_layer_01.md:122"],["zero_slime","ぼくが忘れちゃったこと。君と一緒なら、思い出せるかもしれない。",{"name":"スライム"},"01_layer_01.md:124"],["zero_slime","ぼくの試練、受けてくれる？",{"name":"スライム"},"01_layer_01.md:128"],["hero","うん。一緒に答えを見つけよう。",null,"01_layer_01.md:130"]],"bg":"l1-pool"},{"id":"AX1-L01-P2-post","title":"2地点 戦闘後","src":{"file":"01_layer_01.md","from":132,"to":158},"lines":[["zero_slime","……ぷるっ！",{"name":"スライム"},"01_layer_01.md:134"],["narr","池の目盛りに、小さな光が戻る。",{"fx":"fadein"},"01_layer_01.md:136"],["zero_slime","分かった気がする。いっぱいあることも、何もないことも、どっちも大切なんだね。",{"name":"スライム"},"01_layer_01.md:138"],["hero","うん。ゼロは、何もない状態をちゃんと表せる数なんだ。",null,"01_layer_01.md:140"],["zero_slime","ゼロ……。",{"name":"スライム"},"01_layer_01.md:142"],["narr","スライムは、その言葉を確かめるように繰り返す。",null,"01_layer_01.md:144"],["zero_slime","……なんだか、懐かしい。",{"name":"スライム"},"01_layer_01.md:146"],["voice","役割の記憶が、少し戻ったのかもしれません。",{"name":"コーデックスの声"},"01_layer_01.md:148"],["hero","名前も思い出せそう？",null,"01_layer_01.md:150"],["zero_slime","まだ……。でも、もう少しで思い出せそうな気がする！",{"name":"スライム"},"01_layer_01.md:152"],["narr","水晶池から、街の分岐路へ向かう水路に光が流れ始める。",{"fx":"particles"},"01_layer_01.md:154"],["hero","あっ、道が見えた。",null,"01_layer_01.md:156"],["zero_slime","ありがとう！　また会いに来てね！",{"name":"スライム"},"01_layer_01.md:158"]],"bg":"l1-pool"},{"id":"AX1-L01-P3-pre","title":"ゼロの消えた街 3地点 正負の分岐路","src":{"file":"01_layer_01.md","from":162,"to":220},"lines":[["narr","正負の分岐路",{"kind":"card","card":[{"s":"xs","t":"第三幕"},{"s":"lg","t":"正負の分岐路"}]},"01_layer_01.md:162"],["narr","街を横断する大きな道。中央の水晶標識を境に、左右へ道が分かれている。",null,"01_layer_01.md:166"],["narr","右側には橙色の光。左側には青色の光。",null,"01_layer_01.md:168"],["narr","二匹の小さな守護獣が、互いに言い争っていた。",null,"01_layer_01.md:170"],["plus","だから！　右へ進むのが正しいんだって！",{"name":"プラス"},"01_layer_01.md:172"],["minus","違う！　左へ進む道だって必要だ！",{"name":"マイナス"},"01_layer_01.md:174"],["plus","でも、右の方が数字が大きくなるもん！",{"name":"プラス"},"01_layer_01.md:176"],["minus","大きいからって、正しいとは限らないだろ！",{"name":"マイナス"},"01_layer_01.md:178"],["hero","……ずいぶん揉めてるね。",null,"01_layer_01.md:180"],["plus","あっ！　そこの人間、ちょうどいい！",{"name":"プラス"},"01_layer_01.md:182"],["minus","お前、どっちの道が正しいと思う？",{"name":"マイナス"},"01_layer_01.md:184"],["hero","えっと……どこに行きたいかによるんじゃない？",null,"01_layer_01.md:186"],["plus","えっ？",{"name":"プラス"},"01_layer_01.md:188"],["minus","どういうことだ？",{"name":"マイナス"},"01_layer_01.md:190"],["hero","右に行きたいなら右、左に行きたいなら左。どちらにも意味があるよ。",null,"01_layer_01.md:192"],["plus","でも、どこから数えればいいの？",{"name":"プラス"},"01_layer_01.md:194"],["narr","主人公は中央の水晶標識を見る。",null,"01_layer_01.md:196"],["hero","ここが基準だったんじゃないかな。",null,"01_layer_01.md:198"],["minus","基準……？",{"name":"マイナス"},"01_layer_01.md:200"],["hero","ゼロを原点にして、右を正、左を負と決めれば、位置を表せる。",null,"01_layer_01.md:202"],["plus","ゼロ……。",{"name":"プラス"},"01_layer_01.md:204"],["minus","……そうだ。僕たちは、同じ場所から反対方向へ伸びていたんだ。",{"name":"マイナス"},"01_layer_01.md:206"],["narr","しかし、中央の標識はまだ光らない。",null,"01_layer_01.md:208"],["plus","でも、本当にそれで合ってるのかな？",{"name":"プラス"},"01_layer_01.md:210"],["minus","試練で確かめよう！",{"name":"マイナス"},"01_layer_01.md:212"],["plus","右の力、見せてあげる！",{"name":"プラス"},"01_layer_01.md:216"],["minus","左の力も忘れるなよ！",{"name":"マイナス"},"01_layer_01.md:218"],["hero","二人とも、よろしく！",null,"01_layer_01.md:220"]],"bg":"l1-crossroad"},{"id":"AX1-L01-P3-post","title":"3地点 戦闘後","src":{"file":"01_layer_01.md","from":222,"to":252},"lines":[["plus","あはは！　負けちゃった！",{"name":"プラス"},"01_layer_01.md:224"],["minus","でも、何だかすっきりしたな。",{"name":"マイナス"},"01_layer_01.md:226"],["hero","正と負は、同じ原点を基準にしているんだ。",null,"01_layer_01.md:228"],["plus","僕が右！",{"name":"プラス"},"01_layer_01.md:230"],["minus","僕が左！",{"name":"マイナス"},"01_layer_01.md:232"],["hero","うん。どちらも必要だよ。",null,"01_layer_01.md:234"],["narr","中央の水晶標識に、ゼロを示す光が一瞬浮かぶ。",{"fx":"fadein"},"01_layer_01.md:236"],["plus","あっ！　道が戻った！",{"name":"プラス"},"01_layer_01.md:238"],["minus","北の丘へ進めるようになったぞ！",{"name":"マイナス"},"01_layer_01.md:240"],["hero","北の丘？",null,"01_layer_01.md:242"],["minus","あそこには、距離を守る大きな狼がいるんだ。",{"name":"マイナス"},"01_layer_01.md:244"],["plus","でも、最近は誰も近づけないんだよね。",{"name":"プラス"},"01_layer_01.md:246"],["hero","……行ってみよう。",null,"01_layer_01.md:248"],["narr","主人公が歩き出すと、二匹が声をそろえる。",null,"01_layer_01.md:250"],["twin_fox","気をつけてね！",{"name":"プラス＆マイナス"},"01_layer_01.md:252"]],"bg":"l1-crossroad"},{"id":"AX1-L01-P4-pre","title":"ゼロの消えた街 4地点 絶対値の丘","src":{"file":"01_layer_01.md","from":256,"to":328},"lines":[["narr","絶対値の丘",{"kind":"card","card":[{"s":"xs","t":"第四幕"},{"s":"lg","t":"絶対値の丘"}]},"01_layer_01.md:256"],["narr","街の北側に広がる、緑の丘陵。白銀の道標がいくつも並び、遠くには古い庭園が見える。",null,"01_layer_01.md:260"],["narr","しかし、道標の数字は乱れ、旅人たちは立ち往生していた。",null,"01_layer_01.md:262"],["hero","ここが、絶対値の丘……。",null,"01_layer_01.md:264"],["voice","この丘では、街の中心から各地までの距離を記録していたようです。",{"name":"コーデックスの声"},"01_layer_01.md:266"],["hero","でも、道標がおかしいね。",null,"01_layer_01.md:268"],["narr","一つの道標には「−3」、別の道標には「＋3」と刻まれている。",null,"01_layer_01.md:270"],["hero","方向は違うけど、中心からの距離は同じはずなのに……。",null,"01_layer_01.md:272"],["abs_wolf","……その通りだ。",{"name":"？？？"},"01_layer_01.md:274"],["narr","低く落ち着いた声が響く。",null,"01_layer_01.md:276"],["narr","丘の頂上に、青い結晶をまとった大きな狼が立っていた。",null,"01_layer_01.md:278"],["abs_wolf","正も負も、原点から離れた距離を持つ。",{"name":"アブソリュート・ウルフ"},"01_layer_01.md:280"],["hero","君が、この丘の守護者？",null,"01_layer_01.md:282"],["abs_wolf","そうだ。",{"name":"アブソリュート・ウルフ"},"01_layer_01.md:284"],["hero","街の人たちが困ってる。道を直す方法を教えてほしい。",null,"01_layer_01.md:286"],["abs_wolf","……お前は、ゼロを知っているのか。",{"name":"アブソリュート・ウルフ"},"01_layer_01.md:288"],["hero","うん。",null,"01_layer_01.md:290"],["abs_wolf","ならば、答えてみろ。",{"name":"アブソリュート・ウルフ"},"01_layer_01.md:292"],["narr","狼が前足を踏み出すと、地面に数直線の光が現れる。",null,"01_layer_01.md:294"],["abs_wolf","原点から右へ五つ。左へ五つ。二つの場所は異なる。では、原点からの距離はどうだ？",{"name":"アブソリュート・ウルフ"},"01_layer_01.md:296"],["hero","どちらも5だよ。",null,"01_layer_01.md:298"],["abs_wolf","……そうだ。",{"name":"アブソリュート・ウルフ"},"01_layer_01.md:300"],["narr","狼は主人公の顔ではなく、その手にある書物を見つめる。",null,"01_layer_01.md:302"],["abs_wolf","その書……。",{"name":"アブソリュート・ウルフ"},"01_layer_01.md:304"],["hero","これ？",null,"01_layer_01.md:306"],["narr","短い沈黙。",null,"01_layer_01.md:308"],["abs_wolf","……また、ここへ来たのか。",{"name":"アブソリュート・ウルフ"},"01_layer_01.md:310"],["hero","えっ？",null,"01_layer_01.md:312"],["voice","……。",{"name":"コーデックスの声"},"01_layer_01.md:314"],["hero","どういう意味？　僕は今日初めてこの世界に来たんだけど。",null,"01_layer_01.md:316"],["abs_wolf","……記憶とは、不確かなものだ。",{"name":"アブソリュート・ウルフ"},"01_layer_01.md:318"],["hero","僕のこと、知ってるの？",null,"01_layer_01.md:320"],["abs_wolf","確かめたければ、試練を越えてみせろ。",{"name":"アブソリュート・ウルフ"},"01_layer_01.md:322"],["abs_wolf","方向に惑わされず、本質を見極めよ。",{"name":"アブソリュート・ウルフ"},"01_layer_01.md:326"],["hero","……分かった。",null,"01_layer_01.md:328"]],"bg":"l1-hill"},{"id":"AX1-L01-P4-post","title":"4地点 戦闘後","src":{"file":"01_layer_01.md","from":330,"to":374},"lines":[["narr","丘に刻まれた数直線が、明るく輝き始める。",{"fx":"fadein"},"01_layer_01.md:332"],["abs_wolf","見事だ。",{"name":"アブソリュート・ウルフ"},"01_layer_01.md:334"],["hero","これで、道標を直せる？",null,"01_layer_01.md:336"],["abs_wolf","ああ。正負の符号は方向を示し、絶対値は原点からの距離を示す。",{"name":"アブソリュート・ウルフ"},"01_layer_01.md:338"],["hero","同じ距離でも、反対側にあることはあるんだね。",null,"01_layer_01.md:340"],["abs_wolf","その通りだ。",{"name":"アブソリュート・ウルフ"},"01_layer_01.md:342"],["narr","狼は、丘の奥にある庭園を見つめる。",null,"01_layer_01.md:344"],["abs_wolf","だが、街の異変はまだ終わらぬ。",{"name":"アブソリュート・ウルフ"},"01_layer_01.md:346"],["hero","あの庭園に、何かあるの？",null,"01_layer_01.md:348"],["abs_wolf","そこには、始まりを封じた者がいる。",{"name":"アブソリュート・ウルフ"},"01_layer_01.md:350"],["hero","始まりを封じた者……。",null,"01_layer_01.md:352"],["abs_wolf","ヌル。かつて、空白の意味を守っていた存在だ。",{"name":"アブソリュート・ウルフ"},"01_layer_01.md:354"],["hero","守っていた？",null,"01_layer_01.md:356"],["abs_wolf","今は、その役割を見失っている。",{"name":"アブソリュート・ウルフ"},"01_layer_01.md:358"],["narr","庭園へ続く道の封印が、静かに解ける。",{"fx":"particles"},"01_layer_01.md:360"],["hero","ありがとう。でも、さっきの話……。",null,"01_layer_01.md:362"],["abs_wolf","……先へ進め。",{"name":"アブソリュート・ウルフ"},"01_layer_01.md:364"],["hero","……。",null,"01_layer_01.md:366"],["abs_wolf","答えは、今ここで得られるとは限らぬ。",{"name":"アブソリュート・ウルフ"},"01_layer_01.md:368"],["narr","主人公はコーデックス・アクシオマを見る。",null,"01_layer_01.md:370"],["hero","……行こう。",null,"01_layer_01.md:372"],["voice","……はい。",{"name":"コーデックスの声"},"01_layer_01.md:374"]],"bg":"l1-hill"},{"id":"AX1-L01-P5-pre","title":"ゼロの消えた街 5地点 始原の封印庭園","src":{"file":"01_layer_01.md","from":378,"to":496},"lines":[["narr","始原の封印庭園",{"kind":"card","card":[{"s":"xs","t":"第五幕"},{"s":"lg","t":"始原の封印庭園"}]},"01_layer_01.md:378"],["narr","白銀の門を越えると、静まり返った庭園が広がっていた。",null,"01_layer_01.md:384"],["narr","かつては花々が咲いていたであろう場所には、透明な水晶の花が並んでいる。",null,"01_layer_01.md:386"],["narr","中央には巨大な円環。",null,"01_layer_01.md:388"],["narr","しかし、その円環の一部は黒い結晶によって覆われていた。",null,"01_layer_01.md:390"],["hero","……ここだけ、時間が止まってるみたいだ。",null,"01_layer_01.md:392"],["voice","この庭園は、かつて数の始まりを見守る場所だったのでしょう。",{"name":"コーデックスの声"},"01_layer_01.md:394"],["hero","どうして、こんなことに……。",null,"01_layer_01.md:396"],["nul","失うことが、恐ろしかったからだ。",{"name":"？？？"},"01_layer_01.md:398"],["narr","円環の下に、黒紫の結晶をまとった存在が現れる。",null,"01_layer_01.md:400"],["hero","君が……ヌル？",null,"01_layer_01.md:402"],["nul","そう呼ばれている。",{"name":"ヌル"},"01_layer_01.md:404"],["hero","ゼロの役割を封じたのは、君なの？",null,"01_layer_01.md:406"],["nul","……ああ。",{"name":"ヌル"},"01_layer_01.md:408"],["hero","どうしてそんなことを？",null,"01_layer_01.md:410"],["nul","空になった器。消えた記録。戻らぬもの。",{"name":"ヌル"},"01_layer_01.md:412"],["nul","我は、それらを幾度も見てきた。",{"name":"ヌル"},"01_layer_01.md:414"],["hero","……。",null,"01_layer_01.md:416"],["nul","何もないということは、失われたということだ。",{"name":"ヌル"},"01_layer_01.md:418"],["hero","でも、全部がそうとは限らないよ。",null,"01_layer_01.md:420"],["nul","ならば問おう。何も残っていない場所に、何の意味がある？",{"name":"ヌル"},"01_layer_01.md:422"],["hero","……。",null,"01_layer_01.md:424"],["nul","空白など、初めから存在しなければよい。",{"name":"ヌル"},"01_layer_01.md:426"],["nul","そうすれば、誰も失ったことを知らずに済む。",{"name":"ヌル"},"01_layer_01.md:428"],["hero","……それで、ゼロを封じたんだね。",null,"01_layer_01.md:430"],["nul","そうだ。これ以上、何も失われぬように。",{"name":"ヌル"},"01_layer_01.md:432"],["hero","でも、そのせいで街のみんなが困ってる。",null,"01_layer_01.md:434"],["nul","……。",{"name":"ヌル"},"01_layer_01.md:436"],["hero","空になった箱を記録できなくなって、道の基準も分からなくなって……。",null,"01_layer_01.md:438"],["hero","ゼロを消しても、何かを失うこと自体はなくならないよ。",null,"01_layer_01.md:440"],["nul","……お前に、何が分かる。",{"name":"ヌル"},"01_layer_01.md:442"],["narr","ヌルが主人公へ近づく。",null,"01_layer_01.md:444"],["narr","その視線が、コーデックス・アクシオマの紋章に止まる。",null,"01_layer_01.md:446"],["nul","……その書。",{"name":"ヌル"},"01_layer_01.md:448"],["narr","ヌルの動きが止まる。",null,"01_layer_01.md:450"],["nul","まさか……。",{"name":"ヌル"},"01_layer_01.md:452"],["hero","……？",null,"01_layer_01.md:454"],["narr","ヌルは主人公をじっと見つめる。",null,"01_layer_01.md:456"],["nul","久しいな、{playerName}。",{"name":"ヌル"},"01_layer_01.md:458"],["hero","……え？",null,"01_layer_01.md:460"],["hero","どうして、僕の名前を……？",null,"01_layer_01.md:462"],["nul","……やはり、覚えていないのか。",{"name":"ヌル"},"01_layer_01.md:464"],["hero","何を？",null,"01_layer_01.md:466"],["nul","……。",{"name":"ヌル"},"01_layer_01.md:468"],["hero","ねえ、答えてよ！",null,"01_layer_01.md:470"],["nul","記憶すら失った者が、失うことの意味を語るか。",{"name":"ヌル"},"01_layer_01.md:472"],["hero","……僕が、何かを忘れてるってこと？",null,"01_layer_01.md:474"],["nul","それを知りたければ、まず我に示せ。",{"name":"ヌル"},"01_layer_01.md:476"],["hero","……何を？",null,"01_layer_01.md:478"],["nul","何もないことに、本当に意味があるというのなら。",{"name":"ヌル"},"01_layer_01.md:480"],["narr","黒い結晶が輝き、庭園全体に数式の光が広がる。",{"fx":"particles"},"01_layer_01.md:482"],["nul","その答えを、数理の試練で示してみよ！",{"name":"ヌル"},"01_layer_01.md:484"],["hero","……分かった。",null,"01_layer_01.md:488"],["hero","ゼロは、ただの空白じゃない。",null,"01_layer_01.md:490"],["hero","この街のみんなが、それを教えてくれた。",null,"01_layer_01.md:492"],["nul","ならば来い。",{"name":"ヌル"},"01_layer_01.md:494"],["nul","失われた始まりを、取り戻せるというのなら！",{"name":"ヌル"},"01_layer_01.md:496"]],"bg":"l1-garden"},{"id":"AX1-L01-P5-post","title":"5地点 戦闘後","src":{"file":"01_layer_01.md","from":498,"to":580},"lines":[["narr","最後の試練が終わる。",null,"01_layer_01.md:500"],["narr","黒い結晶に亀裂が走り、庭園を覆っていた暗い光が薄れていく。",null,"01_layer_01.md:502"],["nul","……我が、敗れたか。",{"name":"ヌル"},"01_layer_01.md:504"],["hero","ヌル……。",null,"01_layer_01.md:506"],["nul","何もないことを認めれば、失ったものを思い知らされる。",{"name":"ヌル"},"01_layer_01.md:508"],["nul","我は、それが恐ろしかった。",{"name":"ヌル"},"01_layer_01.md:510"],["hero","……うん。",null,"01_layer_01.md:512"],["nul","だから、空白そのものを封じた。",{"name":"ヌル"},"01_layer_01.md:514"],["hero","でも、ゼロがあるから、空になったことも分かる。",null,"01_layer_01.md:516"],["hero","そして、そこから何かを始めることもできる。",null,"01_layer_01.md:518"],["nul","……始める。",{"name":"ヌル"},"01_layer_01.md:520"],["hero","水晶池のスライムも、ゼロの意味を知って、自分の役割を思い出しかけてた。",null,"01_layer_01.md:522"],["nul","……あの小さな者が。",{"name":"ヌル"},"01_layer_01.md:524"],["hero","ゼロは、なくてもいい数じゃない。",null,"01_layer_01.md:526"],["hero","何もないことを、ちゃんと表してくれる大切な数なんだ。",null,"01_layer_01.md:528"],["narr","ヌルは長い間、何も言わなかった。",null,"01_layer_01.md:530"],["nul","……そうか。",{"name":"ヌル"},"01_layer_01.md:532"],["nul","我は、失うことばかりを恐れ……。",{"name":"ヌル"},"01_layer_01.md:534"],["nul","空白の先に、何かが始まることを忘れていたのだな。",{"name":"ヌル"},"01_layer_01.md:536"],["narr","ヌルが円環に向き直る。",null,"01_layer_01.md:538"],["nul","封印を解こう。",{"name":"ヌル"},"01_layer_01.md:540"],["hero","……！",null,"01_layer_01.md:542"],["nul","我が閉ざした始まりは、我自身の手で戻さねばならぬ。",{"name":"ヌル"},"01_layer_01.md:544"],["narr","ヌルが手をかざす。",null,"01_layer_01.md:546"],["narr","黒い結晶が砕け、円環から白銀の光があふれ出す。",{"fx":"white"},"01_layer_01.md:548"],["narr","庭園の水晶の花が、次々と色を取り戻していく。",{"fx":"particles"},"01_layer_01.md:550"],["hero","……きれいだ。",null,"01_layer_01.md:552"],["nul","……忘れていた。これが、この庭園の本来の姿だった。",{"name":"ヌル"},"01_layer_01.md:554"],["hero","よかった……。",null,"01_layer_01.md:556"],["narr","ヌルは再び主人公を見る。",null,"01_layer_01.md:558"],["nul","……お前も、いつか思い出すのだろうか。",{"name":"ヌル"},"01_layer_01.md:560"],["hero","……僕が忘れたこと？",null,"01_layer_01.md:562"],["nul","……。",{"name":"ヌル"},"01_layer_01.md:564"],["hero","教えてくれないの？",null,"01_layer_01.md:566"],["nul","我に残る記憶も、完全ではない。",{"name":"ヌル"},"01_layer_01.md:568"],["nul","今ここで語れば、かえってお前を誤った道へ導くかもしれぬ。",{"name":"ヌル"},"01_layer_01.md:570"],["hero","……そっか。",null,"01_layer_01.md:572"],["nul","だが、一つだけ言える。",{"name":"ヌル"},"01_layer_01.md:574"],["hero","何？",null,"01_layer_01.md:576"],["nul","失われたものが、すべて消え去ったとは限らぬ。",{"name":"ヌル"},"01_layer_01.md:578"],["narr","主人公はその言葉を、静かに受け止める。",null,"01_layer_01.md:580"]],"bg":"l1-garden"},{"id":"AX1-L01-clear","title":"ゼロの消えた街 クリア後","src":{"file":"01_layer_01.md","from":584,"to":640},"lines":[["narr","ゼロの帰還",{"kind":"card","card":[{"s":"xs","t":"第1層クリア後"},{"s":"lg","t":"ゼロの帰還"}]},"01_layer_01.md:584"],["narr","庭園の円環から放たれた光が、街全体へ広がっていく。",{"fx":"white"},"01_layer_01.md:588"],["narr","計数市場の帳簿に、正しい数字が戻る。",{"bg":"l1-market"},"01_layer_01.md:590"],["count_rabbit","あっ！　数が戻った！",{"name":"カウント・ラビット"},"01_layer_01.md:592"],["count_rabbit","空の箱も、ちゃんと記録できる！",{"name":"カウント・ラビット"},"01_layer_01.md:594"],["narr","水晶池の目盛りが輝き、小さなスライムが顔を上げる。",{"bg":"l1-pool"},"01_layer_01.md:596"],["zero_slime","……あ。",{"name":"スライム"},"01_layer_01.md:598"],["zero_slime","思い出した……！",{"name":"スライム"},"01_layer_01.md:600"],["narr","その体に、ゼロを表す光が宿る。",{"fx":"fadein"},"01_layer_01.md:602"],["zero_slime","ぼくの名前は……ゼロ・スライム！",{"name":"ゼロ・スライム","reveal":"zero_slime"},"01_layer_01.md:604"],["zero_slime","何もないことを、ちゃんと伝えるのがぼくの役割なんだ！",{"name":"ゼロ・スライム"},"01_layer_01.md:606"],["narr","正負の分岐路では、中央の標識が輝く。",{"bg":"l1-crossroad"},"01_layer_01.md:608"],["plus","ゼロを基準に、右へ！",{"name":"プラス"},"01_layer_01.md:610"],["minus","同じゼロから、左へ！",{"name":"マイナス"},"01_layer_01.md:612"],["twin_fox","これで迷わないね！",{"name":"プラス＆マイナス"},"01_layer_01.md:614"],["narr","絶対値の丘では、すべての道標が正常に戻る。",{"bg":"l1-hill"},"01_layer_01.md:616"],["narr","アブソリュート・ウルフは、遠くから街を見守っている。",null,"01_layer_01.md:618"],["abs_wolf","……また一つ、つながったか。",{"name":"アブソリュート・ウルフ"},"01_layer_01.md:620"],["narr","そして、ゼロの広場。",{"bg":"l1-plaza"},"01_layer_01.md:622"],["narr","街の中心にある水晶が、澄んだ光を放つ。",null,"01_layer_01.md:624"],["hero","……戻ったんだ。",null,"01_layer_01.md:626"],["voice","はい。この世界で失われていた、ゼロの役割が。",{"name":"コーデックスの声"},"01_layer_01.md:628"],["hero","みんな、うれしそうだね。",null,"01_layer_01.md:630"],["voice","あなたが、みなさんと一緒に取り戻したのです。",{"name":"コーデックスの声"},"01_layer_01.md:632"],["hero","……僕だけじゃないよ。",null,"01_layer_01.md:634"],["hero","みんなが、自分の役割を思い出そうとしてくれたから。",null,"01_layer_01.md:636"],["voice","……そうですね。",{"name":"コーデックスの声"},"01_layer_01.md:638"],["narr","その声は、どこかうれしそうだった。",null,"01_layer_01.md:640"]],"bg":"l1-garden"},{"id":"AX1-L01-fragment","title":"第一の断片","src":{"file":"01_layer_01.md","from":646,"to":690},"lines":[["narr","突然、コーデックス・アクシオマが淡く輝き始める。",null,"01_layer_01.md:646"],["hero","……あれ？",null,"01_layer_01.md:648"],["narr","書物がひとりでに開く。",{"fx":"bookopen"},"01_layer_01.md:650"],["narr","欠けた円環の紋章に、小さな光の断片が現れる。",{"fx":"emblem"},"01_layer_01.md:652"],["voice","第一の断片が戻りました。",{"name":"コーデックスの声"},"01_layer_01.md:654"],["hero","第一の断片？",null,"01_layer_01.md:656"],["voice","この書に残されていた、失われた記録の一つです。",{"name":"コーデックスの声"},"01_layer_01.md:658"],["hero","……読めるようになってる。",null,"01_layer_01.md:660"],["narr","「何もないことを知る者は、すべての始まりを知る。」",{"kind":"card","card":[{"s":"xs","t":"第一の断片｜数の起点"},{"s":"lg","t":"「何もないことを知る者は、すべての始まりを知る。」"}],"fx":"fadein"},"01_layer_01.md:662"],["hero","何もないことを知る者は、すべての始まりを知る……。",null,"01_layer_01.md:668"],["hero","……ゼロのことだね。",null,"01_layer_01.md:670"],["voice","はい。そして、この言葉には、まだ続きがあるのかもしれません。",{"name":"コーデックスの声"},"01_layer_01.md:672"],["hero","続き？",null,"01_layer_01.md:674"],["narr","主人公は、書物の欠けた円環を見つめる。",null,"01_layer_01.md:676"],["hero","……ほかにも断片があるんだね。",null,"01_layer_01.md:678"],["voice","ええ。",{"name":"コーデックスの声"},"01_layer_01.md:680"],["hero","それを集めれば、この世界で何が起きたのか分かる？",null,"01_layer_01.md:682"],["voice","……少しずつ、分かることが増えるはずです。",{"name":"コーデックスの声"},"01_layer_01.md:684"],["hero","そっか。",null,"01_layer_01.md:686"],["narr","主人公は書物を閉じる。",null,"01_layer_01.md:688"],["hero","だったら、先へ進もう。",null,"01_layer_01.md:690"]],"bg":"l1-garden"},{"id":"AX1-L01-gate","title":"ゼロの消えた街 界門","src":{"file":"01_layer_01.md","from":694,"to":774},"lines":[["narr","第2層への界門",{"kind":"card","card":[{"s":"xs","t":"終幕"},{"s":"lg","t":"第2層への界門"}]},"01_layer_01.md:694"],["narr","街の北端。",null,"01_layer_01.md:698"],["narr","かつて光を失っていた巨大な白銀の環状門が、再び輝き始めていた。",null,"01_layer_01.md:700"],["narr","門の中央には、青い空とは異なる景色が映し出されている。",null,"01_layer_01.md:702"],["narr","赤い水晶の森。煙突が立ち並ぶ工房の町。遠くにそびえる巨大な炎の門。",null,"01_layer_01.md:704"],["hero","……これが、界門。",null,"01_layer_01.md:706"],["voice","はい。世界と世界をつなぐ道です。",{"name":"コーデックスの声"},"01_layer_01.md:708"],["hero","向こうに見えるのが、次の世界？",null,"01_layer_01.md:710"],["voice","第二の世界。炎の分配路が広がる場所です。",{"name":"コーデックスの声"},"01_layer_01.md:712"],["hero","……でも、何だか静かだね。",null,"01_layer_01.md:714"],["voice","本来なら、あの工房からは絶えず炎の光が見えるはずなのですが……。",{"name":"コーデックスの声"},"01_layer_01.md:716"],["hero","……向こうでも、何か起きてるんだ。",null,"01_layer_01.md:718"],["narr","主人公は、復興した街を振り返る。",null,"01_layer_01.md:720"],["narr","市場からは住人たちの声が聞こえ、水晶池には光が戻っている。",null,"01_layer_01.md:722"],["hero","……最初は、どうなることかと思ったけど。",null,"01_layer_01.md:724"],["voice","はい。",{"name":"コーデックスの声"},"01_layer_01.md:726"],["hero","僕にも、できることがあったんだね。",null,"01_layer_01.md:728"],["voice","……ええ。",{"name":"コーデックスの声"},"01_layer_01.md:730"],["hero","次の世界でも、誰かが困ってるなら助けたい。",null,"01_layer_01.md:732"],["narr","コーデックス・アクシオマが、静かに輝く。",null,"01_layer_01.md:734"],["voice","……ありがとうございます。",{"name":"コーデックスの声"},"01_layer_01.md:736"],["hero","それに、まだ聞きたいこともあるし。",null,"01_layer_01.md:738"],["voice","……？",{"name":"コーデックスの声"},"01_layer_01.md:740"],["hero","ヌルも、あの狼も、僕のことを知ってるみたいだった。",null,"01_layer_01.md:742"],["hero","君も……何か知ってるんじゃない？",null,"01_layer_01.md:744"],["narr","短い沈黙。",null,"01_layer_01.md:746"],["voice","……今は、すべてをお話しすることができません。",{"name":"コーデックスの声"},"01_layer_01.md:748"],["hero","……やっぱり。",null,"01_layer_01.md:750"],["voice","ごめんなさい。",{"name":"コーデックスの声"},"01_layer_01.md:752"],["hero","いいよ。でも、いつか教えてね。",null,"01_layer_01.md:754"],["voice","……はい。必ず。",{"name":"コーデックスの声"},"01_layer_01.md:756"],["narr","主人公は界門へ向き直る。",null,"01_layer_01.md:758"],["hero","よし、行こう！",null,"01_layer_01.md:760"],["narr","白銀の光が主人公を包み込む。",{"fx":"white"},"01_layer_01.md:762"],["narr","門の向こうに、赤い水晶の森が広がる。",null,"01_layer_01.md:764"],["narr","第1層「ゼロの消えた街」踏破",{"kind":"card","card":[{"s":"xs","t":"LAYER 1 COMPLETE"},{"s":"lg","t":"第1層「ゼロの消えた街」踏破"},{"s":"sm","t":"次なる世界へ"}],"fx":"fadein"},"01_layer_01.md:766"],["narr","暗転。",{"fx":"black"},"01_layer_01.md:772"]],"bg":"l1-north-gate"}]}],"source":{"files":[{"file":"docs/axiomia/story/00_prologue.md","sha256":"3cdb87b77805f17b218c8d2a270e66b02d422bebc23f5512f9dd2f87f8511e6b","lines":458},{"file":"docs/axiomia/story/01_layer_01.md","sha256":"1cad2eaca148c29b5b394f540354b372f8445c72c2ecbcf0378c0afa7afbf1cc","lines":808}],"skipped":[{"src":"00_prologue.md:22","why":"stage direction","text":"背景：夕暮れの高校教室／登場：主人公"},{"src":"00_prologue.md:66","why":"stage direction","text":"背景：光が差し込む教室／登場：主人公・謎の声"},{"src":"00_prologue.md:135","why":"stage direction","text":"背景：教室に広がる幾何学の光／登場：主人公・謎の声"},{"src":"00_prologue.md:227","why":"stage direction","text":"背景：星空のような空間／登場：主人公・謎の声"},{"src":"00_prologue.md:299","why":"structural heading (not displayed)","text":"幻視の終わり"},{"src":"00_prologue.md:347","why":"stage direction","text":"背景：第1層の街の入口／登場：主人公・謎の声・カウント・ラビット"},{"src":"01_layer_01.md:12","why":"stage direction","text":"主要地点1・カウント・ラビット"},{"src":"01_layer_01.md:44","why":"structural heading (not displayed)","text":"戦闘後"},{"src":"01_layer_01.md:72","why":"stage direction","text":"主要地点2・ゼロ・スライム"},{"src":"01_layer_01.md:126","why":"structural heading (not displayed)","text":"戦闘前"},{"src":"01_layer_01.md:132","why":"structural heading (not displayed)","text":"戦闘後"},{"src":"01_layer_01.md:164","why":"stage direction","text":"主要地点3・プラス＆マイナス"},{"src":"01_layer_01.md:214","why":"structural heading (not displayed)","text":"戦闘前"},{"src":"01_layer_01.md:222","why":"structural heading (not displayed)","text":"戦闘後"},{"src":"01_layer_01.md:258","why":"stage direction","text":"主要地点4・アブソリュート・ウルフ"},{"src":"01_layer_01.md:324","why":"structural heading (not displayed)","text":"戦闘前"},{"src":"01_layer_01.md:330","why":"structural heading (not displayed)","text":"戦闘後"},{"src":"01_layer_01.md:380","why":"stage direction","text":"主要地点5・ボス：ヌル"},{"src":"01_layer_01.md:382","why":"structural heading (not displayed)","text":"庭園への到着"},{"src":"01_layer_01.md:486","why":"structural heading (not displayed)","text":"ボス戦前"},{"src":"01_layer_01.md:498","why":"structural heading (not displayed)","text":"ボス戦後"},{"src":"01_layer_01.md:586","why":"stage direction","text":"事件解決演出・街の復興"},{"src":"01_layer_01.md:665","why":"caption (production note)","text":"確定済みの原文を変更せず採用"},{"src":"01_layer_01.md:696","why":"stage direction","text":"第1層エピローグ・次の世界への接続"},{"src":"01_layer_01.md:774","why":"cue","text":"第2層「炎を抱く分配の門」へ続く。"}]}}
